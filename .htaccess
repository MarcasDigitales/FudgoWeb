Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteBase /
RewriteRule ^affiliate/?$ affiliate.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^help/?$ help.html [L]
RewriteRule ^terminoscondiciones/?$ terminoscondiciones.html [L]
RewriteRule ^gracias/?$ gracias.html [L]
RewriteRule ^leads/?$ leads.html [L]


# Cabeceras básicas de seguridad (si mod_headers está disponible).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
